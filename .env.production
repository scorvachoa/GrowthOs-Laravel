# Plantilla de producción de GrowthOS.
#
# Uso (una de estas dos opciones):
#   1) Copiar a .env y completar los valores marcados con <...>:
#        cp .env.production .env && php artisan key:generate
#   2) Mantener este archivo y exportar APP_ENV=production en el entorno del
#      servidor (Apache/nginx/systemd/supervisor) para que Laravel lo cargue.
#
# APP_KEY, DB_* y las API keys se completan en el servidor; nunca se versionan.

APP_NAME=GrowthOS
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://<tu-dominio.com>

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_PE

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=<nombre_bd>
DB_USERNAME=<usuario_bd>
DB_PASSWORD=<password_bd>

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# true por defecto en APP_ENV=production (config/session.php); declararlo es opcional
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# sync funciona con un solo worker; con múltiples workers usar database o redis
QUEUE_CONNECTION=sync

CACHE_STORE=file

# YouTube Data API v3
YOUTUBE_API_KEY=

# Facebook / Instagram Graph API (App ID + App Secret = token de 60 días con auto-refresh)
FACEBOOK_GRAPH_VERSION=v22.0
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Google Gemini AI
GEMINI_API_KEY=
GEMINI_KEY_1=
GEMINI_KEY_2=
GEMINI_KEY_3=
GEMINI_KEY_4=

# ElevenLabs Text-to-Speech
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# DeepL Traducción (terminación :fx = plan gratuito)
DEEPL_API_KEY=

MAIL_MAILER=smtp
MAIL_HOST=<smtp-host>
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=<no-reply@tu-dominio.com>
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
